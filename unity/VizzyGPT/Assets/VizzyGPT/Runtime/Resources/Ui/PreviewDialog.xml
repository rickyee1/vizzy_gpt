<?xml version="1.0" encoding="utf-8"?>
<XmlLayout xmlns="http://www.w3schools.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="..\..\..\..\ModTools\UI\XmlLayout.xsd">
  <Include path="Ui/Xml/Styles.xml" />
  <Panel id="preview-dialog" class="dialog-background">
    <Panel id="preview-dialog-content" class="panel border" width="680" height="560">
      <TextMeshPro text="Vizzy GPT Preview" class="header" rectAlignment="UpperLeft" offsetXY="20 -20" />
      <TextMeshPro id="summary-text" class="value" rectAlignment="UpperCenter" width="640" offsetXY="0 -60" />
      <VerticalScrollView id="preview-scroll" class="no-image" anchorMin="0 0" anchorMax="1 1" offsetMin="20 75" offsetMax="-20 -110">
        <VerticalLayout class="no-image" childForceExpandHeight="false" spacing="10">
          <TextMeshPro text="Added" class="label" />
          <TextMeshPro id="added-text" class="value" />
          <TextMeshPro text="Changed" class="label" />
          <TextMeshPro id="changed-text" class="value" />
          <TextMeshPro text="Removed" class="label" />
          <TextMeshPro id="removed-text" class="value" />
          <TextMeshPro text="Warnings" class="label" />
          <TextMeshPro id="warnings-text" class="value" />
        </VerticalLayout>
      </VerticalScrollView>
      <Button id="cancel-button" class="btn" rectAlignment="LowerLeft" width="180" offsetXY="20 20" onClick="OnCancelButtonClicked();"><TextMeshPro text="Cancel" /></Button>
      <Button id="apply-button" class="btn btn-primary" rectAlignment="LowerRight" width="180" offsetXY="-20 20" onClick="OnApplyButtonClicked();"><TextMeshPro text="Apply" /></Button>
    </Panel>
  </Panel>
</XmlLayout>
